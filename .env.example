# Ganti dengan connection string Postgres kamu (Neon / Supabase / lokal)
DATABASE_URL="postgresql://user:password@host:5432/undangan?schema=public"

# Password untuk masuk ke /admin
ADMIN_PASSWORD="ganti-password-ini"

# String acak minimal 32 karakter untuk menandatangani cookie sesi
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# URL publik situs (dipakai untuk link tamu & OG image)
NEXT_PUBLIC_SITE_URL="https://undangan-kamu.vercel.app"
